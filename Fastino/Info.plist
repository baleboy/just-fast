<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSHealthShareUsageDescription</key>
	<string>Fastino shows your sleep and weight alongside your fasting history, so you can see how they move together. The data stays on your device and is never uploaded.</string>
	<!-- Fastino never writes to Health: HealthKitProvider passes `toShare: []`
	     at both call sites and calls no save API, and §4.8 keeps it that way.
	     The key is here anyway because upload validation demands both Health
	     purpose strings from any binary that *links* HealthKit, write or not —
	     without it the build is rejected outright. iOS only ever presents this
	     string when an app requests share authorisation, which this one never
	     does, so no user will see it; it says what it says so that the plist
	     stays true to the code if anyone reads it. Should the app ever write a
	     sample, this has to be rewritten to describe that, honestly. -->
	<key>NSHealthUpdateUsageDescription</key>
	<string>Fastino never writes anything to Health. It only reads your sleep and weight, to show them alongside your fasting history.</string>
	<key>INAlternativeAppNames</key>
	<array>
		<dict>
			<key>INAlternativeAppName</key>
			<string>Fasting</string>
		</dict>
		<dict>
			<key>INAlternativeAppName</key>
			<string>Fast</string>
		</dict>
	</array>
	<key>UIAppFonts</key>
	<array>
		<string>Baloo2-SemiBold.ttf</string>
		<string>Baloo2-Bold.ttf</string>
		<string>Baloo2-ExtraBold.ttf</string>
	</array>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.baleware.fastino</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>fastino</string>
			</array>
		</dict>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<!-- Export compliance. The app ships no encryption of its own; the only
	     cryptography it touches is the HTTPS the system performs on its behalf
	     inside CloudKit, which is exempt. Declaring it here answers the question
	     App Store Connect otherwise asks by hand on every single upload, holding
	     the build at "Missing Compliance" — and so out of testers' hands — until
	     someone answers it. If the app ever adds encryption that isn't the
	     platform's own, this has to become true and the answer stops being free. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
