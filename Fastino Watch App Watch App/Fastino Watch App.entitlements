<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Not for our own notifications — the watch deliberately schedules none
	     (see NotificationManager.add). This is what lets CloudKit wake the app
	     with a silent push when the phone changes something, so a fast started
	     on one device reaches the other without waiting to be opened. -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- The container MUST match Fastino.entitlements exactly. A watch pointed
	     at a different container syncs to a different database: both apps appear
	     to work, and they never converge. -->
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.com.baleware.fastino</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
</dict>
</plist>
