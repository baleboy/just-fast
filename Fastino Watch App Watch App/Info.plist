<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- UIAppFonts is the one key with no INFOPLIST_KEY_ build-setting
	     equivalent, so the watch target needs a real plist to register Baloo 2.
	     The faces themselves come from Shared/Resources/Fonts via folder
	     membership. A face that fails to register falls back to the system font
	     silently, with no error — so check the first run visually. -->
	<key>UIAppFonts</key>
	<array>
		<string>Baloo2-SemiBold.ttf</string>
		<string>Baloo2-Bold.ttf</string>
		<string>Baloo2-ExtraBold.ttf</string>
	</array>
	<!-- Required by CloudKit, which logs "BUG IN CLIENT OF CLOUDKIT" at launch
	     without it: this is what lets a silent push wake the app so a change
	     made on the phone arrives without the watch being opened. Pairs with
	     aps-environment in the entitlements — the entitlement grants the push,
	     this declares the mode it's delivered in, and both are needed. The iOS
	     target has carried the same key from the start.

	     Separately, the watch may now also schedule its *own* notifications,
	     but only on a standalone install where there's no iPhone app to defer
	     to — see NotificationOwnership. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<!-- Export compliance. The app ships no encryption of its own; the only
	     cryptography it touches is the HTTPS the system performs on its behalf
	     inside CloudKit, which is exempt. Declaring it here answers the question
	     App Store Connect otherwise asks by hand on every single upload, holding
	     the build at "Missing Compliance" — and so out of testers' hands — until
	     someone answers it. If the app ever adds encryption that isn't the
	     platform's own, this has to become true and the answer stops being free. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
