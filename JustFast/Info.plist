<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Siri app-name aliases (§4.6). AppShortcut phrases must contain the app
	     name, so "Fasting" as an alias is what turns "Start \(.applicationName)"
	     into "Hey Siri, start fasting". -->
	<key>INAlternativeAppNames</key>
	<array>
		<dict>
			<key>INAlternativeAppName</key>
			<string>Fasting</string>
		</dict>
		<dict>
			<key>INAlternativeAppName</key>
			<string>Fast</string>
		</dict>
		<dict>
			<key>INAlternativeAppName</key>
			<string>Just Fasting</string>
		</dict>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
</dict>
</plist>
